---
import '../styles/global.css';
interface Props {
  title?: string;
  description?: string;
}
const {
  title = 'Monfort Brian',
  description = 'AI Engineer building RAG systems, automation workflows, and production AI tools for East Africa and beyond.',
} = Astro.props;
---

<!doctype html>
<html lang='en'>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
    <meta name='description' content={description} />
    <meta property='og:title' content={title} />
    <meta property='og:description' content={description} />
    <title>{title}</title>

    <link rel='icon' type='image/svg+xml' href='/favicon-new.svg' />
  </head>
  <body>
    <slot />
  </body>
</html>
