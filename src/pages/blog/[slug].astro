---
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const posts = [
    {
      slug: 'building-rag-for-african-regulation',
      title: 'Building a RAG System Over Government Directive PDFs',
      date: '2025',
      externalUrl: null, // null = render inline; set a URL to redirect
      tags: ['RAG', 'Python', 'LangChain', 'NLP'],
      sections: [
        { id: 'why',       label: 'Why this matters' },
        { id: 'challenge', label: 'The challenge' },
        { id: 'approach',  label: 'My approach' },
        { id: 'code',      label: 'Key code' },
        { id: 'takeaways', label: 'Takeaways' },
      ],
      content: `
        <section id="why">
          <h2>Why this matters</h2>
          <p>Government regulatory PDFs in Africa are dense, scanned, and completely unsearchable. Building AI on top of them is harder than it sounds — and more important than most people realise.</p>
        </section>

        <section id="challenge">
          <h2>The challenge</h2>
          <p>The BNR (National Bank of Rwanda) publishes directives as scanned PDFs. No text layer, no metadata, no structure. Standard PDF parsers return garbage or nothing.</p>
          <p>On top of that, regulatory language references other directives constantly — "as defined in Article 3 of Directive 1/2019" — so retrieval without cross-document context fails badly.</p>
        </section>

        <section id="approach">
          <h2>My approach</h2>
          <p>Three-stage pipeline: OCR with GPT-4o Vision for scanned pages, layout-aware chunking at the article level (not page level), and hybrid BM25 + vector retrieval with directive-aware metadata filtering.</p>
          <p>Article-level chunking was the key insight. Regulatory articles are the atomic unit of meaning. Splitting at the page boundary destroys context and kills retrieval quality.</p>
          <figure>
            <img src="/blog/rag-pipeline-diagram.png" alt="RAG pipeline diagram" loading="lazy" />
            <figcaption>The three-stage ingestion pipeline</figcaption>
          </figure>
        </section>

        <section id="code">
          <h2>Key code</h2>
          <p>The chunking logic preserves directive number, chapter, article title, and page as metadata on every chunk — giving the retriever structured filters to work with.</p>
          <pre><code>chunk_metadata = {
  "directive_id": "BNR-2021-04",
  "chapter": "Capital Requirements",
  "article": "Article 12",
  "page": 8
}</code></pre>
        </section>

        <section id="takeaways">
          <h2>Takeaways</h2>
          <ul>
            <li>Chunk at the semantic unit of the domain, not at fixed token counts</li>
            <li>GPT-4o Vision OCR is expensive but the only reliable option for scanned African gov docs</li>
            <li>Hybrid retrieval (BM25 + vector) consistently beats pure vector for regulatory text</li>
            <li>Metadata filtering is not optional — it's what separates toy RAG from production RAG</li>
          </ul>
        </section>
      `,
    },
  ];

  return posts.map((p) => ({
    params: { slug: p.slug },
    props: p,
  }));
}

const { title, date, tags, externalUrl, sections, content } = Astro.props;

// If there's an external URL, redirect at build time isn't possible in Astro
// without a redirect page — we'll show a nice redirect screen instead
---

<Base title={title}>
  {externalUrl ? (
    <!-- External redirect page -->
    <div class="redirect-page">
      <div class="redirect-col">
        <a href="/" class="page-back">
          <svg width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M9.5 2.5L2.5 9.5M2.5 9.5H8M2.5 9.5V4"/>
          </svg>
          Back
        </a>
        <p class="redirect-label">This post lives on an external platform</p>
        <h1 class="page-title">{title}</h1>
        <div class="page-meta">{date} {tags.map((t) => <span class="meta-tag">{t}</span>)}</div>
        <a href={externalUrl} class="read-external" target="_blank" rel="noopener noreferrer">
          Read the full post
          <svg width="10" height="10" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M2.5 9.5L9.5 2.5M9.5 2.5H4M9.5 2.5V8"/>
          </svg>
        </a>
      </div>
    </div>
  ) : (
    <>
      <div class="progress-bar" id="progress-bar"></div>
      <div class="work-layout">
        <aside class="toc" id="toc">
          <div class="toc-inner">
            <div class="toc-label">Contents</div>
            <nav>
              {sections && sections.map((s) => (
                <a href={`#${s.id}`} class="toc-item" data-section={s.id}>
                  <span class="toc-bar-wrap">
                    <span class="toc-bar" id={`bar-${s.id}`}></span>
                  </span>
                  <span class="toc-text">{s.label}</span>
                </a>
              ))}
            </nav>
          </div>
        </aside>

        <main class="work-main">
          <div class="work-col">
            <a href="/" class="page-back">
              <svg width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5">
                <path d="M9.5 2.5L2.5 9.5M2.5 9.5H8M2.5 9.5V4"/>
              </svg>
              Back
            </a>
            <h1 class="page-title">{title}</h1>
            <div class="page-meta">
              {date}
              {tags.map((t) => <span class="meta-tag">{t}</span>)}
            </div>
            <div class="page-body" id="article-body" set:html={content} />
          </div>
        </main>
      </div>
    </>
  )}

  <style>
    /* Shared with work pages — ideally move to global.css */
    .progress-bar {
      position: fixed; top: 0; left: 0; height: 2px; width: 0%;
      background: var(--link); z-index: 300; transition: width 0.1s linear;
    }
    .work-layout {
      display: flex; align-items: flex-start; min-height: 100vh;
      max-width: 900px; margin: 0 auto; padding: 0 20px; gap: 0;
    }
    .toc {
      width: 180px; flex-shrink: 0; position: sticky; top: 40px;
      padding-top: 80px; padding-right: 24px;
    }
    .toc-inner { display: flex; flex-direction: column; gap: 4px; }
    .toc-label {
      font-size: 10px; font-weight: 500; color: var(--text3);
      letter-spacing: 0.08em; text-transform: uppercase; margin-bottom: 10px;
    }
    .toc-item {
      display: flex; align-items: center; gap: 8px;
      padding: 4px 0; text-decoration: none; color: var(--text3);
      font-size: 11px; line-height: 1.3; transition: color 0.15s; border-radius: 4px;
    }
    .toc-item:hover, .toc-item.active { color: var(--text); }
    .toc-bar-wrap {
      width: 3px; height: 28px; background: var(--border);
      border-radius: 2px; flex-shrink: 0; overflow: hidden; position: relative;
    }
    .toc-bar {
      position: absolute; bottom: 0; left: 0;
      width: 100%; height: 0%; background: var(--link);
      border-radius: 2px; transition: height 0.15s ease;
    }
    .toc-item.active .toc-bar-wrap { background: rgba(126,184,247,0.15); }
    .toc-item.active .toc-bar      { height: 100%; }

    .work-main { flex: 1; min-width: 0; }
    .work-col  { max-width: 580px; padding: 50px 0 80px; }

    .page-back {
      display: inline-flex; align-items: center; gap: 6px;
      font-size: 12px; color: var(--text2); margin-bottom: 28px;
      transition: color 0.15s; text-decoration: none;
    }
    .page-back:hover { color: var(--text); }
    .page-title {
      font-size: 19px; font-weight: 500; color: var(--text);
      margin-bottom: 10px; letter-spacing: -0.01em; line-height: 1.3;
    }
    .page-meta {
      display: flex; flex-wrap: wrap; align-items: center;
      gap: 6px; font-size: 11px; color: var(--text3); margin-bottom: 32px;
    }
    .meta-tag {
      background: var(--bg2); border: 1px solid var(--border);
      padding: 2px 7px; border-radius: 4px; font-size: 10px;
    }
    .page-body section { margin-bottom: 40px; scroll-margin-top: 32px; }
    .page-body h2 {
      font-size: 13px; font-weight: 500; color: var(--text);
      margin-bottom: 12px; padding-bottom: 8px; border-bottom: 1px solid var(--border);
    }
    .page-body p  { font-size: 13px; color: var(--text2); line-height: 1.85; margin-bottom: 12px; }
    .page-body ul { margin: 0 0 12px 18px; }
    .page-body li { font-size: 13px; color: var(--text2); line-height: 1.7; margin-bottom: 4px; }
    .page-body a  { color: var(--link); border-bottom: 1px solid rgba(126,184,247,0.25); }
    .page-body a:hover { border-color: var(--link); }
    .page-body figure {
      margin: 20px 0 24px; border-radius: 10px; overflow: hidden; border: 1px solid var(--border);
    }
    .page-body figure img { width: 100%; height: auto; display: block; }
    .page-body figcaption {
      font-size: 11px; color: var(--text3); padding: 8px 12px;
      background: var(--bg2); border-top: 1px solid var(--border);
    }
    .page-body pre {
      background: var(--bg2); border: 1px solid var(--border); border-radius: 8px;
      padding: 16px; overflow-x: auto; margin-bottom: 16px;
    }
    .page-body code {
      font-family: var(--mono); font-size: 12px; color: var(--text2); line-height: 1.6;
    }
    .case-links { display: flex; flex-wrap: wrap; gap: 8px; }
    .case-link {
      display: inline-flex; align-items: center; gap: 7px;
      padding: 8px 14px; border-radius: 8px;
      border: 1px solid var(--border2) !important; background: var(--bg2);
      font-size: 12px; color: var(--text2); text-decoration: none !important;
      border-bottom: none !important;
      transition: color 0.15s, background 0.15s;
    }
    .case-link:hover { color: var(--text); background: var(--bg3); }

    /* Redirect page */
    .redirect-page { max-width: 580px; margin: 0 auto; padding: 80px 20px; }
    .redirect-col {}
    .redirect-label { font-size: 11px; color: var(--text3); margin-bottom: 12px; }
    .read-external {
      display: inline-flex; align-items: center; gap: 6px;
      margin-top: 24px; padding: 10px 18px; border-radius: 8px;
      border: 1px solid var(--border2); background: var(--bg2);
      font-size: 13px; color: var(--text); text-decoration: none;
      transition: background 0.15s, border-color 0.15s;
    }
    .read-external:hover { background: var(--bg3); }

    @media (max-width: 700px) {
      .toc { display: none; }
      .work-layout { padding: 0 20px; }
    }
  </style>

  {!externalUrl && (
    <script>
      const bar = document.getElementById('progress-bar');
      function updateProgress() {
        const total = document.body.scrollHeight - window.innerHeight;
        if (bar) bar.style.width = (window.scrollY / total * 100) + '%';
      }
      window.addEventListener('scroll', updateProgress, { passive: true });

      const tocItems = document.querySelectorAll('.toc-item');
      const sections = document.querySelectorAll('.page-body section[id]');
      function onScroll() {
        let current = '';
        sections.forEach((sec) => {
          if (window.scrollY >= sec.offsetTop - 80) current = sec.id;
        });
        tocItems.forEach((item) => {
          item.classList.toggle('active', item.dataset.section === current);
        });
      }
      window.addEventListener('scroll', onScroll, { passive: true });
      onScroll();

      tocItems.forEach((item) => {
        item.addEventListener('click', (e) => {
          e.preventDefault();
          const target = document.getElementById(item.dataset.section);
          if (target) target.scrollIntoView({ behavior: 'smooth', block: 'start' });
        });
      });
    </script>
  )}
</Base>