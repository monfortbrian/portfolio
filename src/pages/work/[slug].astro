---
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const cases = [
    {
      slug: 'regiq',
      title: 'RegIQ: Building Regulatory Intelligence for East African Banks',
      description:
        'How I built a RAG pipeline over 26 BNR directive PDFs, cutting compliance query time from 25 minutes to under 30 seconds.',
      date: '2025',
      tags: [
        'RAG',
        'LangChain',
        'ChromaDB',
        'FastAPI',
        'Docker',
        'Chrome Extension',
      ],
      sections: [
        { id: 'problem', label: 'The problem' },
        { id: 'built', label: 'What I built' },
        { id: 'architecture', label: 'Architecture' },
        { id: 'design', label: 'Design decisions' },
        { id: 'results', label: 'Results' },
        { id: 'links', label: 'Links' },
      ],
      content: `
        <section id="problem">
          <h2>The problem</h2>
          <p>Compliance officers at Rwandan banks spend 15–25 minutes per question manually searching BNR directive PDFs. With 26 directives across 10 years, no indexed, searchable system existed. Every lookup meant downloading a PDF, running Ctrl+F, reading context, and cross-referencing other directives.</p>
        </section>
        <section id="built">
          <h2>What I built</h2>
          <p>RegIQ is a RAG pipeline over the full National Bank of Rwanda directive corpus - 19 directives, article-level chunking, with directive number, article title, chapter, and page preserved as metadata on every chunk.</p>
          <p>Scanned PDFs (the majority of African central bank documents) are handled via GPT-4o Vision OCR with table extraction. Clean PDFs use PyMuPDF with layout-aware parsing.</p>
        </section>
        <section id="architecture">
          <h2>Architecture</h2>
          <p>The pipeline runs in three stages: ingestion (PDF → chunks → ChromaDB), retrieval (hybrid BM25 + vector search), and generation (GPT-4o with citation-aware prompting).</p>
          <p>The Chrome extension intercepts the user's query, hits the FastAPI endpoint, and renders the answer inline with directive citations and confidence scores.</p>
        </section>
        <section id="design">
          <h2>Design decisions</h2>
          <p>Article-level chunking (not page-level) was the critical choice. Regulatory language is precise - splitting mid-article destroys context. This alone improved retrieval relevance from ~60% to ~91% on the eval set.</p>
          <p>Metadata filtering lets users scope queries to a specific directive year or number, cutting hallucination risk significantly.</p>
        </section>
        <section id="results">
          <h2>Results</h2>
          <p>Query time dropped from 15–25 minutes to under 30 seconds. Tested across 3 compliance officers at a Rwandan commercial bank over 2 weeks.</p>
          <ul>
            <li>91% retrieval relevance on 50-question eval set</li>
            <li>26 directives indexed, ~4,200 chunks</li>
            <li>Chrome extension deployed internally</li>
          </ul>
        </section>
        <section id="links">
          <h2>Links</h2>
          <div class="case-links">
            <a href="https://github.com/monfortbrian" class="case-link" target="_blank" rel="noopener">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0 1 12 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/></svg>
              GitHub Repository
            </a>
          </div>
        </section>
      `,
    },
    {
      slug: 'opsbot',
      title: 'OpsBot: AI Operations Intelligence Across Two Industries',
      description:
        'A Slack-native AI assistant that aggregates operational data, generates natural-language summaries, and surfaces anomalies automatically.',
      date: '2024',
      tags: ['Python', 'OpenAI', 'Slack', 'n8n', 'PostgreSQL'],
      sections: [
        { id: 'problem', label: 'The problem' },
        { id: 'built', label: 'What I built' },
        { id: 'results', label: 'Results' },
        { id: 'links', label: 'Links' },
      ],
      content: `
        <section id="problem">
          <h2>The problem</h2>
          <p>Operations teams at two companies were drowning in manual reporting - pulling data from 4–6 systems daily to produce status reports nobody had time to read.</p>
        </section>
        <section id="built">
          <h2>What I built</h2>
          <p>OpsBot is a Slack-native AI assistant that aggregates operational data, generates natural-language summaries, and surfaces anomalies before humans notice them.</p>
        </section>
        <section id="results">
          <h2>Results</h2>
          <p>Reduced daily reporting time by 3 hours per ops manager. Anomaly detection caught two critical stock issues before they became customer-facing problems.</p>
        </section>
        <section id="links">
          <h2>Links</h2>
          <div class="case-links">
            <a href="https://github.com/monfortbrian" class="case-link" target="_blank" rel="noopener">GitHub</a>
          </div>
        </section>
      `,
    },
    {
      slug: 'qms-pipeline',
      title: 'QMS Data Pipeline: From Queue System to Executive Dashboard',
      description:
        'An automated ETL pipeline turning siloed queue management data into live Power BI executive dashboards with SLA tracking.',
      date: '2024',
      tags: ['Python', 'PostgreSQL', 'Power BI', 'ETL', 'REST API'],
      sections: [
        { id: 'problem', label: 'The problem' },
        { id: 'built', label: 'What I built' },
        { id: 'results', label: 'Results' },
        { id: 'links', label: 'Links' },
      ],
      content: `
        <section id="problem">
          <h2>The problem</h2>
          <p>Queue management data sat in a siloed system with no API and no export. Leadership wanted weekly KPIs but the only option was manual CSV exports and Excel manipulation.</p>
        </section>
        <section id="built">
          <h2>What I built</h2>
          <p>An automated ETL pipeline that polls the QMS REST API every hour, normalises and stores data in PostgreSQL, and feeds a live Power BI executive dashboard with SLA tracking.</p>
        </section>
        <section id="results">
          <h2>Results</h2>
          <p>Eliminated 4 hours of weekly manual work. Executives now have real-time queue visibility with drill-down by branch, service type, and time of day.</p>
        </section>
        <section id="links">
          <h2>Links</h2>
          <div class="case-links">
            <a href="https://dev.to/monfortbrian_/how-i-built-an-automated-operational-analytics-pipeline-from-a-queue-management-system-ecc" class="case-link" target="_blank" rel="noopener">Read on dev.to</a>
          </div>
        </section>
      `,
    },
  ];

  return cases.map((c) => ({
    params: { slug: c.slug },
    props: c,
  }));
}

const { title, description, date, tags, sections, content } = Astro.props;
---

<Base title={title} description={description}>
  <div
    class='progress-bar'
    id='progress-bar'
    role='progressbar'
    aria-label='Reading progress'
  >
  </div>

  <div class='work-layout'>
    <!-- TOC sidebar -->
    <aside class='toc' aria-label='Table of contents'>
      <div class='toc-inner'>
        <div class='toc-label'>Contents</div>
        <nav>
          {
            sections.map((s) => (
              <a href={`#${s.id}`} class='toc-item' data-section={s.id}>
                <span class='toc-bar-wrap' aria-hidden='true'>
                  <span class='toc-bar' />
                </span>
                <span class='toc-text'>{s.label}</span>
              </a>
            ))
          }
        </nav>
      </div>
    </aside>

    <!-- Article -->
    <article class='work-main'>
      <div class='work-col'>
        <a href='/' class='page-back'>
          <svg
            width='12'
            height='12'
            viewBox='0 0 12 12'
            fill='none'
            stroke='currentColor'
            stroke-width='1.5'
            aria-hidden='true'
          >
            <path d='M9.5 2.5L2.5 9.5M2.5 9.5H8M2.5 9.5V4'></path>
          </svg>
          Back
        </a>

        <h1 class='page-title'>{title}</h1>

        <div class='page-meta'>
          <time datetime={date}>{date}</time>
          {tags.map((t) => <span class='meta-tag'>{t}</span>)}
        </div>

        <div class='page-body' id='article-body' set:html={content} />
      </div>
    </article>
  </div>
</Base>

<style>
  .progress-bar {
    position: fixed;
    top: 0;
    left: 0;
    height: 2px;
    width: 0%;
    background: var(--link);
    z-index: 300;
    transition: width 0.1s linear;
  }
  .work-layout {
    display: flex;
    align-items: flex-start;
    min-height: 100vh;
    max-width: 900px;
    margin: 0 auto;
    padding: 0 20px;
  }

  /* TOC */
  .toc {
    width: 180px;
    flex-shrink: 0;
    position: sticky;
    top: 40px;
    padding-top: 80px;
    padding-right: 24px;
  }
  .toc-inner {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .toc-label {
    font-family: var(--font-ui);
    font-size: 10px;
    font-weight: 500;
    color: var(--text3);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 10px;
  }
  .toc-item {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 4px 0;
    text-decoration: none;
    color: var(--text3);
    font-family: var(--font-code);
    font-size: 11px;
    line-height: 1.3;
    transition: color 0.15s;
    border-radius: 4px;
  }
  .toc-item:hover,
  .toc-item.active {
    color: var(--text);
  }
  .toc-bar-wrap {
    width: 3px;
    height: 28px;
    background: var(--border);
    border-radius: 2px;
    flex-shrink: 0;
    overflow: hidden;
    position: relative;
  }
  .toc-bar {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 0%;
    background: var(--link);
    border-radius: 2px;
    transition: height 0.15s ease;
  }
  .toc-item.active .toc-bar-wrap {
    background: rgba(88, 166, 255, 0.15);
  }
  .toc-item.active .toc-bar {
    height: 100%;
  }

  /* Article */
  .work-main {
    flex: 1;
    min-width: 0;
  }
  .work-col {
    max-width: 580px;
    padding: 50px 0 80px;
  }

  .page-back {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-ui);
    font-size: 12px;
    color: var(--text2);
    margin-bottom: 28px;
    transition: color 0.15s;
    text-decoration: none;
  }
  .page-back:hover {
    color: var(--text);
  }

  .page-title {
    font-family: var(--font-ui);
    font-size: 19px;
    font-weight: 500;
    color: var(--text);
    margin-bottom: 10px;
    letter-spacing: -0.01em;
    line-height: 1.3;
  }
  .page-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
    font-family: var(--font-code);
    font-size: 11px;
    color: var(--text3);
    margin-bottom: 32px;
  }
  .meta-tag {
    background: var(--bg2);
    border: 1px solid var(--border);
    padding: 2px 7px;
    border-radius: 4px;
    font-size: 10px;
  }

  /* Body */
  .page-body section {
    margin-bottom: 40px;
    scroll-margin-top: 32px;
  }
  .page-body h2 {
    font-family: var(--font-ui);
    font-size: 13px;
    font-weight: 500;
    color: var(--text);
    margin-bottom: 12px;
    padding-bottom: 8px;
    border-bottom: 1px solid var(--border);
  }
  .page-body p {
    font-family: var(--font-code);
    font-size: 13px;
    color: var(--text2);
    line-height: 1.85;
    margin-bottom: 12px;
  }
  .page-body ul {
    margin: 0 0 12px 18px;
  }
  .page-body li {
    font-family: var(--font-code);
    font-size: 13px;
    color: var(--text2);
    line-height: 1.7;
    margin-bottom: 4px;
  }
  .page-body a {
    color: var(--link);
    border-bottom: 1px solid rgba(88, 166, 255, 0.25);
  }
  .page-body a:hover {
    border-color: var(--link);
  }
  .page-body figure {
    margin: 20px 0 24px;
    border-radius: 10px;
    overflow: hidden;
    border: 1px solid var(--border);
  }
  .page-body figure img {
    width: 100%;
    height: auto;
    display: block;
  }
  .page-body figcaption {
    font-family: var(--font-code);
    font-size: 11px;
    color: var(--text3);
    padding: 8px 12px;
    background: var(--bg2);
    border-top: 1px solid var(--border);
  }
  .page-body pre {
    background: var(--bg2);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 16px;
    overflow-x: auto;
    margin-bottom: 16px;
  }
  .page-body code {
    font-family: var(--font-code); /* uses CSS var, not hardcoded */
    font-size: 12px;
    color: var(--text2);
    line-height: 1.6;
  }
  .case-links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .case-link {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 8px 14px;
    border-radius: 8px;
    border: 1px solid var(--border2);
    background: var(--bg2);
    font-family: var(--font-code);
    font-size: 12px;
    color: var(--text2);
    text-decoration: none;
    border-bottom: none;
    transition:
      color 0.15s,
      background 0.15s;
  }
  .case-link:hover {
    color: var(--text);
    background: var(--bg3);
  }

  @media (max-width: 700px) {
    .toc {
      display: none;
    }
    .work-layout {
      padding: 0 20px;
    }
  }
</style>

<script>
  const bar = document.getElementById('progress-bar');
  const tocItems = document.querySelectorAll('.toc-item');
  const sections = document.querySelectorAll('.page-body section[id]');

  function updateProgress() {
    const total = document.body.scrollHeight - window.innerHeight;
    if (bar && total > 0)
      bar.style.width = (window.scrollY / total) * 100 + '%';
  }

  function onScroll() {
    updateProgress();
    let current = '';
    sections.forEach((sec) => {
      if (window.scrollY >= (sec as HTMLElement).offsetTop - 80)
        current = sec.id;
    });
    tocItems.forEach((item) => {
      item.classList.toggle(
        'active',
        (item as HTMLElement).dataset.section === current,
      );
    });
  }

  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  tocItems.forEach((item) => {
    item.addEventListener('click', (e) => {
      e.preventDefault();
      const target = document.getElementById(
        (item as HTMLElement).dataset.section!,
      );
      if (target) target.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
  });
</script>
