        </div>
      </div>
      <div>
        <div class='hero-name'>Monfort Brian</div>
      </div>

      <div class='hero-tag'>Product Design Engineer.</div>

      <div class='hero-bio'>
        <p>
          Between design and engineering - blending UI, code & automation. I
          craft and ship beautiful, interactive, pixel-perfect web experiences
          and scalable systems. <a
            href='https://npmjs.com/~monfortbrian'
            target='_blank'
            rel='noopener'>OSS contributor</a
          > building tools that connect and stay accessible. Partnered with Silicon
          Valley startups.
        </p>
      </div>

      <div class='cta-row'>
        <a href='mailto:hello@monfortbrian.com' class='cta-btn'>
          Mail
          <svg
            width='10'
            height='10'
            viewBox='0 0 12 12'
            fill='none'
            stroke='currentColor'
            stroke-width='1.5'
            ><path d='M2.5 9.5L9.5 2.5M9.5 2.5H4M9.5 2.5V8'></path></svg
          >
        </a>
        <a
          href='https://dribbble.com/monfortbrian'
          target='_blank'
          rel='noopener'
          class='cta-btn'
        >
          Dribbble
          <svg
            width='10'
            height='10'
            viewBox='0 0 12 12'
            fill='none'
            stroke='currentColor'
            stroke-width='1.5'
            ><path d='M2.5 9.5L9.5 2.5M9.5 2.5H4M9.5 2.5V8'></path></svg
          >
        </a>
        <a
          href='https://github.com/monfortbrian'
          target='_blank'
          rel='noopener'
          class='cta-btn'
        >
          GitHub
          <svg
            width='10'
            height='10'
            viewBox='0 0 12 12'
            fill='none'
            stroke='currentColor'
            stroke-width='1.5'
            ><path d='M2.5 9.5L9.5 2.5M9.5 2.5H4M9.5 2.5V8'></path></svg
          >
        </a>
      </div>
    </section>

    <!-- What I bring -->
    <section class='bring-section'>
      <div class='section-title'>Skills</div>
      <div class='bring-inner' id='bring-container'>
        {
          pills.map((p) => (
            <div
              class='pill'
              style={`top:${p.top};left:${p.left}; transform: rotate(${p.rotate}deg);`}
              data-origin-top={p.top}
              data-origin-left={p.left}
              data-rotate={p.rotate}
            >
              {p.label}
            </div>
          ))
        }
        <div class='bring-center'>
          <div class='bring-title'>What I bring to the table</div>
          <div class='bring-sub'>
            Digital experiences and systems that engage users and help you stand
            out
          </div>
        </div>
      </div>
    </section>

    <!-- Projects -->
    <section class='section'>
      <div class='section-title'>Projects</div>
      <div class='projects-grid'>
        {
          projects.map((p) => (
            <button
              class='project-card'
              style={`background:${p.color}`}
              data-project={p.id}
              aria-label={`Open ${p.name} details`}
              type='button'
            >
              <div class='project-card-logo' set:html={p.svg} />
              <div class='project-card-name'>{p.name}</div>
            </button>
          ))
        }
      </div>
    </section>

    <!-- Case Studies -->
    <section class='section'>
      <div class='section-title'>Case Studies</div>
      <div>
        {
          caseStudies.map((c) => (
            <a href={`/work/${c.slug}`} class='list-row'>
              <div class='list-thumb'>{c.emoji}</div>
              <div class='list-info'>
                <div class='list-title'>{c.title}</div>
                <div class='list-date'>{c.date}</div>
              </div>
            </a>
          ))
        }
      </div>
    </section>

    <!-- Writing -->
    <section class='section'>
      <div class='section-title'>Writing</div>
      <div>
        {
          writing.map((w) => (
            <a
              href={w.href || `/blog/${w.slug}`}
              class='list-row'
              target={w.href ? '_blank' : undefined}
              rel={w.href ? 'noopener noreferrer' : undefined}
            >
              <div class='list-thumb'>{w.emoji}</div>
              <div class='list-info'>
                <div class='list-title'>{w.title}</div>
                <div class='list-date'>{w.date}</div>
              </div>
            </a>
          ))
        }
      </div>
    </section>

    <!-- Footer -->
    <footer class='footer'>
      <div class='footer-inner'>
        <div class='footer-links'>
          <a
            href='https://github.com/monfortbrian'
            target='_blank'
            rel='noopener'>GitHub</a
          >
          <a href='https://linkedin.com' target='_blank' rel='noopener'
            >LinkedIn</a
          >
          <a href='https://dribbble.com' target='_blank' rel='noopener'
            >Dribbble</a
          >
          <a
            href='https://YOUR_GDRIVE_OR_DROPBOX_LINK'
            target='_blank'
            rel='noopener'>Résumé</a
          >
        </div>
        <div class='theme-toggle'>
          <button
            class='theme-btn'
            data-theme-val='light'
            aria-label='Light mode'
          >
            <Sun size={15} />
          </button>
          <button
            class='theme-btn active'
            data-theme-val='system'
            aria-label='System mode'
          >
            <LaptopMinimal size={15} />
          </button>
          <button
            class='theme-btn'
            data-theme-val='dark'
            aria-label='Dark mode'
          >
            <Moon size={15} />
          </button>
        </div>
      </div>
    </footer>
  </div>

  <!-- Project Modal -->
  <div
    class='modal-backdrop'
    id='modal'
    role='dialog'
    aria-modal='true'
    aria-label='Project details'
  >
    <div class='modal'>
      <button class='modal-close' id='modal-close' aria-label='Close'>×</button>
      <div class='modal-icon' id='modal-icon'></div>
      <div class='modal-name' id='modal-name'></div>
      <div class='modal-desc' id='modal-desc'></div>
      <div class='modal-tags' id='modal-tags'></div>
      <a
        class='modal-link'
        id='modal-link'
        target='_blank'
        rel='noopener noreferrer'
      >
        <span id='modal-link-label'></span>
        <svg
          width='10'
          height='10'
          viewBox='0 0 12 12'
          fill='none'
          stroke='currentColor'
          stroke-width='1.5'
          ><path d='M2.5 9.5L9.5 2.5M9.5 2.5H4M9.5 2.5V8'></path></svg
        >
      </a>
    </div>
  </div>

  <script define:vars={{ projects }}>
    // ── Theme ──────────────────────────────────────────────────────────────
    const root = document.documentElement;
    const btns = document.querySelectorAll('.theme-btn');

    function applyTheme(val) {
      const pref =
        val === 'system'
          ? window.matchMedia('(prefers-color-scheme: dark)').matches
            ? 'dark'
            : 'light'
          : val;
      root.setAttribute('data-theme', pref);
      localStorage.setItem('theme', val);
      btns.forEach((b) =>
        b.classList.toggle('active', b.dataset.themeVal === val),
      );
    }

    const saved = localStorage.getItem('theme') || 'system';
    applyTheme(saved);
    btns.forEach((b) =>
      b.addEventListener('click', () => applyTheme(b.dataset.themeVal)),
    );
    window
      .matchMedia('(prefers-color-scheme: dark)')
      .addEventListener('change', () => {
        if (localStorage.getItem('theme') === 'system') applyTheme('system');
      });

    // ── Draggable pills ────────────────────────────────────────────────────
    const container = document.getElementById('bring-container');
    const pillEls = container.querySelectorAll('.pill');

    pillEls.forEach((pill) => {
      let dragging = false;
      let startX, startY, startLeft, startTop;

      function getOriginPx() {
        const cw = container.offsetWidth;
        const ch = container.offsetHeight;
        const ot = pill.dataset.originTop;
        const ol = pill.dataset.originLeft;
        const topPx = ot.includes('%')
          ? (parseFloat(ot) / 100) * ch
          : parseFloat(ot);
        const leftPx = ol.includes('%')
          ? (parseFloat(ol) / 100) * cw
          : parseFloat(ol);
        return { topPx, leftPx };
      }

      pill.addEventListener('mousedown', (e) => {
        dragging = true;
        pill.classList.add('dragging');
        const rect = pill.getBoundingClientRect();
        const cRect = container.getBoundingClientRect();
        startX = e.clientX;
        startY = e.clientY;
        startLeft = rect.left - cRect.left;
        startTop = rect.top - cRect.top;
        pill.style.left = startLeft + 'px';
        pill.style.top = startTop + 'px';
        e.preventDefault();
      });

      document.addEventListener('mousemove', (e) => {
        if (!dragging) return;
        const dx = e.clientX - startX;
        const dy = e.clientY - startY;
        const newLeft = Math.max(
          0,
          Math.min(container.offsetWidth - pill.offsetWidth, startLeft + dx),
        );
        const newTop = Math.max(
          0,
          Math.min(container.offsetHeight - pill.offsetHeight, startTop + dy),
        );
        pill.style.left = newLeft + 'px';
        pill.style.top = newTop + 'px';
      });

      document.addEventListener('mouseup', () => {
        if (!dragging) return;
        dragging = false;
        pill.classList.remove('dragging');
        const { topPx, leftPx } = getOriginPx();
        const rotation = pill.dataset.rotate || 0;
        pill.style.transition =
          'left 0.5s cubic-bezier(0.25,0,0.15,1), top 0.5s cubic-bezier(0.25,0,0.15,1)';
        pill.style.left = leftPx + 'px';
        pill.style.top = topPx + 'px';
        pill.style.transform = `rotate(${rotation}deg)`;
        setTimeout(() => {
          pill.style.transition = '';
        }, 520);
      });

      pill.addEventListener(
        'touchstart',
        (e) => {
          const t = e.touches[0];
          const rect = pill.getBoundingClientRect();
          const cRect = container.getBoundingClientRect();
          startX = t.clientX;
          startY = t.clientY;
          startLeft = rect.left - cRect.left;
          startTop = rect.top - cRect.top;
          pill.style.left = startLeft + 'px';
          pill.style.top = startTop + 'px';
          dragging = true;
          pill.classList.add('dragging');
          e.preventDefault();
        },
        { passive: false },
      );

      document.addEventListener('touchmove', (e) => {
        if (!dragging) return;
        const t = e.touches[0];
        const dx = t.clientX - startX;
        const dy = t.clientY - startY;
        const newLeft = Math.max(
          0,
          Math.min(container.offsetWidth - pill.offsetWidth, startLeft + dx),
        );
        const newTop = Math.max(
          0,
          Math.min(container.offsetHeight - pill.offsetHeight, startTop + dy),
        );
        pill.style.left = newLeft + 'px';
        pill.style.top = newTop + 'px';
      });

      document.addEventListener('touchend', () => {
        if (!dragging) return;
        dragging = false;
        pill.classList.remove('dragging');
        const { topPx, leftPx } = getOriginPx();
        pill.style.transition =
          'left 0.5s cubic-bezier(0.25,0,0.15,1), top 0.5s cubic-bezier(0.25,0,0.15,1)';
        pill.style.left = leftPx + 'px';
        pill.style.top = topPx + 'px';
        setTimeout(() => {
          pill.style.transition = '';
        }, 520);
      });
    });

    // ── Modal ──────────────────────────────────────────────────────────────
    const modal = document.getElementById('modal');
    const mClose = document.getElementById('modal-close');
    const mIcon = document.getElementById('modal-icon');
    const mName = document.getElementById('modal-name');
    const mDesc = document.getElementById('modal-desc');
    const mTags = document.getElementById('modal-tags');
    const mLink = document.getElementById('modal-link');
    const mLinkLabel = document.getElementById('modal-link-label');

    function openModal(id) {
      const p = projects.find((x) => x.id === id);
      if (!p) return;
      // SVG icon (30x30 clipped circle)
      mIcon.innerHTML = p.svg;
      mName.textContent = p.name;
      mDesc.textContent = p.desc;
      mTags.innerHTML = p.tags
        .map((t) => `<span class="modal-tag">${t}</span>`)
        .join('');
      mLink.href = p.href;
      mLinkLabel.textContent = p.label;
      modal.classList.add('open');
      document.body.style.overflow = 'hidden';
    }

    function closeModal() {
      modal.classList.remove('open');
      document.body.style.overflow = '';
    }

    document.querySelectorAll('[data-project]').forEach((btn) => {
      btn.addEventListener('click', () => openModal(btn.dataset.project));
    });

    mClose.addEventListener('click', closeModal);
    modal.addEventListener('click', (e) => {
      if (e.target === modal) closeModal();
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeModal();
    });
  </script>
</Base>
