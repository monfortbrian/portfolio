  <script define:vars={{ projects }}>
    /* ── Theme ──────────────────────────────────────── */
    const root = document.documentElement;
    const themeBtns = document.querySelectorAll('.theme-btn');

    function applyTheme(val) {
      const pref =
        val === 'system'
          ? window.matchMedia('(prefers-color-scheme: dark)').matches
            ? 'dark'
            : 'light'
          : val;
      root.setAttribute('data-theme', pref);
      localStorage.setItem('theme', val);
      themeBtns.forEach((b) =>
        b.classList.toggle('active', b.dataset.themeVal === val),
      );
    }

    applyTheme(localStorage.getItem('theme') || 'system');
    themeBtns.forEach((b) =>
      b.addEventListener('click', () => applyTheme(b.dataset.themeVal)),
    );
    window
      .matchMedia('(prefers-color-scheme: dark)')
      .addEventListener('change', () => {
        if (localStorage.getItem('theme') === 'system') applyTheme('system');
      });

    /* ── Draggable Pills ────────────────────────────── */
    const container = document.getElementById('bring-container');

    container.querySelectorAll('.pill').forEach((pill) => {
      let dragging = false,
        startX,
        startY,
        startLeft,
        startTop;

      function originPx() {
        const ot = pill.dataset.originTop,
          ol = pill.dataset.originLeft;
        const cw = container.offsetWidth,
          ch = container.offsetHeight;
        return {
          topPx: ot.includes('%')
            ? (parseFloat(ot) / 100) * ch
            : parseFloat(ot),
          leftPx: ol.includes('%')
            ? (parseFloat(ol) / 100) * cw
            : parseFloat(ol),
        };
      }
      function clamp(v, lo, hi) {
        return Math.max(lo, Math.min(hi, v));
      }

      pill.addEventListener('mousedown', (e) => {
        dragging = true;
        pill.classList.add('dragging');
        const r = pill.getBoundingClientRect(),
          cr = container.getBoundingClientRect();
        startX = e.clientX;
        startY = e.clientY;
        startLeft = r.left - cr.left;
        startTop = r.top - cr.top;
        pill.style.left = startLeft + 'px';
        pill.style.top = startTop + 'px';
        e.preventDefault();
      });
      document.addEventListener('mousemove', (e) => {
        if (!dragging) return;
        pill.style.left =
          clamp(
            startLeft + e.clientX - startX,
            0,
            container.offsetWidth - pill.offsetWidth,
          ) + 'px';
        pill.style.top =
          clamp(
            startTop + e.clientY - startY,
            0,
            container.offsetHeight - pill.offsetHeight,
          ) + 'px';
      });
      document.addEventListener('mouseup', () => {
        if (!dragging) return;
        dragging = false;
        pill.classList.remove('dragging');
        const { topPx, leftPx } = originPx();
        pill.style.transition =
          'left .45s cubic-bezier(.25,0,.15,1),top .45s cubic-bezier(.25,0,.15,1)';
        pill.style.left = leftPx + 'px';
        pill.style.top = topPx + 'px';
        pill.style.transform = `rotate(${pill.dataset.rotate || 0}deg)`;
        setTimeout(() => {
          pill.style.transition = '';
        }, 470);
      });

      pill.addEventListener(
        'touchstart',
        (e) => {
          const t = e.touches[0],
            r = pill.getBoundingClientRect(),
            cr = container.getBoundingClientRect();
          startX = t.clientX;
          startY = t.clientY;
          startLeft = r.left - cr.left;
          startTop = r.top - cr.top;
          pill.style.left = startLeft + 'px';
          pill.style.top = startTop + 'px';
          dragging = true;
          pill.classList.add('dragging');
          e.preventDefault();
        },
        { passive: false },
      );
      document.addEventListener('touchmove', (e) => {
        if (!dragging) return;
        const t = e.touches[0];
        pill.style.left =
          clamp(
            startLeft + t.clientX - startX,
            0,
            container.offsetWidth - pill.offsetWidth,
          ) + 'px';
        pill.style.top =
          clamp(
            startTop + t.clientY - startY,
            0,
            container.offsetHeight - pill.offsetHeight,
          ) + 'px';
      });
      document.addEventListener('touchend', () => {
        if (!dragging) return;
        dragging = false;
        pill.classList.remove('dragging');
        const { topPx, leftPx } = originPx();
        pill.style.transition =
          'left .45s cubic-bezier(.25,0,.15,1),top .45s cubic-bezier(.25,0,.15,1)';
        pill.style.left = leftPx + 'px';
        pill.style.top = topPx + 'px';
        setTimeout(() => {
          pill.style.transition = '';
        }, 470);
      });
    });

    /* ── Project Modal ──────────────────────────────── */
    const modal = document.getElementById('modal');
    const mIcon = document.getElementById('modal-icon');
    const mName = document.getElementById('modal-name');
    const mDesc = document.getElementById('modal-desc');
    const mTags = document.getElementById('modal-tags');
    const mLink = document.getElementById('modal-link');
    const mLinkLabel = document.getElementById('modal-link-label');

    function withUniqueIds(svg, id) {
      return svg
        .replaceAll('id="a"', `id="grad-${id}"`)
        .replaceAll('url(#a)', `url(#grad-${id})`);
    }

    function openModal(id) {
      const p = projects.find((x) => x.id === id);
      if (!p) return;
      mIcon.innerHTML = `<div class="icon-inner">${withUniqueIds(p.svg, p.id)}</div>`;
      mName.textContent = p.name;
      mDesc.textContent = p.desc;
      mTags.innerHTML = p.tags
        .map((t) => `<span class="modal-tag">${t}</span>`)
        .join('');
      mLink.href = p.href;
      mLinkLabel.textContent = p.label;
      modal.classList.add('open');
      document.body.style.overflow = 'hidden';
      document.getElementById('modal-close').focus();
    }

    function closeModal() {
      modal.classList.remove('open');
      document.body.style.overflow = '';
    }

    document
      .querySelectorAll('[data-project]')
      .forEach((btn) =>
        btn.addEventListener('click', () => openModal(btn.dataset.project)),
      );
    document
      .getElementById('modal-close')
      .addEventListener('click', closeModal);
    modal.addEventListener('click', (e) => {
      if (e.target === modal) closeModal();
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeModal();
    });
  </script>
</Base>
